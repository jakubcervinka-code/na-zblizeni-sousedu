{
  "name": "na-zblizeni-sousedu",
  "version": "1.0.0",
  "description": "Dashboard pro komunikaci sousedů",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "tsx watch server/index.ts",
    "build": "cd client && npm run build",
    "preview": "cd client && npm run preview",
    "start": "tsx server/index.ts"
  },
  "keywords": [
    "neighbors",
    "community",
    "dashboard",
    "communication"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "concurrently": "^8.2.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6"
  }
}
